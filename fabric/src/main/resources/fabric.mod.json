  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.lunix.svruptime.fabric.SvrUptimeFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "26.1.x"
  }
}
